---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  factCheckedBy?: string;
  heroImage?: string;
  tags?: string[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author: authorSlug,
  factCheckedBy,
  heroImage,
  tags = [],
} = Astro.props;

const authors = await getCollection('authors');
const author = authors.find((a) => a.slug === authorSlug) ?? authors.find((a) => a.slug === 'editorial-team');
const factChecker = factCheckedBy
  ? authors.find((a) => a.slug === factCheckedBy)
  : undefined;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`${title} — OnlineCheckPrinter`} description={description} image={heroImage}>
  <article class="max-w-3xl mx-auto px-4 py-10">
    <div class="mb-6 text-sm text-slate-500">
      <a href="/articles" class="hover:text-brand">&larr; All articles</a>
    </div>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-3">
        {tags.map((tag) => (
          <span class="text-xs font-semibold uppercase tracking-wide text-brand bg-brand-light px-2 py-1 rounded">
            {tag}
          </span>
        ))}
      </div>
    )}

    <h1 class="text-4xl font-extrabold text-slate-900 leading-tight mb-4">{title}</h1>
    <p class="text-lg text-slate-600 mb-6">{description}</p>

    {author && (
      <div class="flex items-center gap-4 mb-8 border-b border-slate-200 pb-6">
        <a href={`/authors/${author.slug}`} class="flex-shrink-0">
          <div class="w-12 h-12 rounded-full bg-brand text-white grid place-items-center font-bold">
            {author.data.name.split(' ').map((n) => n[0]).join('')}
          </div>
        </a>
        <div class="flex-1 text-sm">
          <div>
            By <a href={`/authors/${author.slug}`} class="font-semibold text-slate-900 hover:text-brand">
              {author.data.name}
            </a>
            <span class="text-slate-500"> · {author.data.title}</span>
          </div>
          <div class="text-slate-500 mt-0.5">
            <time datetime={pubDate.toISOString()}>Published {fmt(pubDate)}</time>
            {updatedDate && <span> · Updated {fmt(updatedDate)}</span>}
            {factChecker && (
              <span> · Fact-checked by <a href={`/authors/${factChecker.data.slug}`} class="text-slate-700 hover:text-brand">{factChecker.data.name}</a></span>
            )}
          </div>
        </div>
      </div>
    )}

    {heroImage && (
      <img src={heroImage} alt="" class="w-full rounded-lg mb-8" loading="eager" />
    )}

    <div class="prose-article">
      <slot />
    </div>

    {author && author.slug !== 'editorial-team' && (
      <div class="mt-12 p-6 bg-slate-50 border border-slate-200 rounded-lg">
        <div class="flex items-start gap-4">
          <a href={`/authors/${author.slug}`} class="flex-shrink-0">
            <div class="w-14 h-14 rounded-full bg-brand text-white grid place-items-center text-xl font-bold">
              {author.data.name.split(' ').map((n) => n[0]).join('')}
            </div>
          </a>
          <div class="flex-1">
            <div class="text-xs uppercase tracking-wide text-slate-500 font-semibold mb-1">
              About the author
            </div>
            <a href={`/authors/${author.slug}`} class="font-bold text-slate-900 hover:text-brand">
              {author.data.name}
            </a>
            <span class="text-slate-500 text-sm"> · {author.data.title}</span>
            <p class="text-sm text-slate-600 mt-1">{author.data.bio}</p>
          </div>
        </div>
      </div>
    )}

    <div class="mt-8 p-6 bg-brand-light/40 border border-brand-light rounded-lg text-sm text-slate-600">
      <strong class="text-slate-900">Disclosure:</strong> This article may contain affiliate links.
      If you sign up through one, we may earn a commission at no extra cost to you. See our
      <a href="/disclosure" class="text-brand underline">full disclosure</a>.
    </div>
  </article>
</BaseLayout>
