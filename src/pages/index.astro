---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featured = articles.filter((a) => a.data.featured).slice(0, 2);
const recent = articles.slice(0, 4);

const authors = await getCollection('authors');
const named = authors.filter((a) => a.slug !== 'editorial-team');
---

<BaseLayout
  title="OnlineCheckPrinter — The Independent Authority on Business Check-Printing Services"
  description="Independent, math-first guides and reviews of check-printing services and software for businesses. Written and fact-checked by specialist payment-systems and payment-security editors."
>
  <section class="bg-gradient-to-b from-brand-light to-white">
    <div class="max-w-5xl mx-auto px-4 py-20 text-center">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-brand bg-white px-3 py-1 rounded-full border border-brand-light mb-4">
        Independent · Fact-checked · Updated 2026
      </span>
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 leading-tight">
        The Independent Authority on<br />
        <span class="text-brand">Business Check-Printing Services</span>
      </h1>
      <p class="text-lg text-slate-600 mt-6 max-w-2xl mx-auto">
        Honest, math-first reviews of the services, software, and DIY setups businesses use to
        print and mail checks — written by specialist payment-systems and payment-security
        editors, fact-checked against current vendor pricing and terms.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/calculator"
          class="bg-brand text-white px-6 py-3 rounded-md font-semibold hover:bg-brand-dark transition-colors"
        >
          Free Cost Calculator
        </a>
        <a
          href="/articles"
          class="bg-white border border-slate-300 text-slate-700 px-6 py-3 rounded-md font-semibold hover:border-brand hover:text-brand transition-colors"
        >
          Read the Guides
        </a>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white">
    <div class="max-w-5xl mx-auto px-4 py-8 grid gap-6 md:grid-cols-3 text-center">
      <div>
        <div class="text-3xl font-extrabold text-brand">$0.50–$1.50</div>
        <div class="text-sm text-slate-600 mt-1">Typical per-check cost via a printing/mailing service</div>
      </div>
      <div>
        <div class="text-3xl font-extrabold text-brand">Under $0.10</div>
        <div class="text-sm text-slate-600 mt-1">Typical per-check cost printing your own, at volume</div>
      </div>
      <div>
        <div class="text-3xl font-extrabold text-brand">Positive Pay</div>
        <div class="text-sm text-slate-600 mt-1">The bank program most businesses haven't set up</div>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 py-16">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">Featured Guides</h2>
      <p class="text-slate-600 mb-8">Start here if you're new to the strategy.</p>
      <div class="grid gap-6 md:grid-cols-2">
        {featured.map((article) => (
          <a
            href={`/articles/${article.slug}`}
            class="block bg-white border border-slate-200 rounded-lg p-6 hover:border-brand hover:shadow-md transition-all"
          >
            <div class="flex flex-wrap gap-2 mb-3">
              {article.data.tags.slice(0, 2).map((tag) => (
                <span class="text-xs font-semibold uppercase tracking-wide text-brand bg-brand-light px-2 py-1 rounded">
                  {tag}
                </span>
              ))}
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">{article.data.title}</h3>
            <p class="text-slate-600">{article.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="bg-slate-50 border-y border-slate-200">
    <div class="max-w-6xl mx-auto px-4 py-16">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">Why trust us?</h2>
      <p class="text-slate-600 mb-10 max-w-2xl">
        Every recommendation on this site starts with the same question: does the math
        actually work at your volume? We refuse to recommend a service that costs more than
        printing checks yourself — and we'll tell you exactly when the cheaper option isn't
        worth the risk.
      </p>
      <div class="grid gap-8 md:grid-cols-3">
        <div>
          <div class="w-10 h-10 rounded bg-brand text-white grid place-items-center font-bold mb-3">
            1
          </div>
          <h3 class="font-bold text-slate-900 mb-2">Math you can verify</h3>
          <p class="text-slate-600 text-sm">
            Every recommendation includes the break-even calculation so you can confirm it
            against your own volume. No hand-waving, no pricing claims we can't defend.
          </p>
        </div>
        <div>
          <div class="w-10 h-10 rounded bg-brand text-white grid place-items-center font-bold mb-3">
            2
          </div>
          <h3 class="font-bold text-slate-900 mb-2">Specialist editors</h3>
          <p class="text-slate-600 text-sm">
            Articles are written by payment-systems and payment-security editors — not
            generalists. Every piece is cross-checked by a second editor before publication.
          </p>
        </div>
        <div>
          <div class="w-10 h-10 rounded bg-brand text-white grid place-items-center font-bold mb-3">
            3
          </div>
          <h3 class="font-bold text-slate-900 mb-2">No paid placements</h3>
          <p class="text-slate-600 text-sm">
            We use affiliate links but we rank by value to the reader, not by commission
            rate. See our full <a href="/disclosure" class="text-brand underline">disclosure</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-2xl font-bold text-slate-900 mb-2">Meet the editors</h2>
    <p class="text-slate-600 mb-8">
      The named experts behind every recommendation on this site.
    </p>
    <div class="grid gap-4 md:grid-cols-2">
      {named.map((author) => (
        <a
          href={`/authors/${author.slug}`}
          class="flex items-start gap-4 bg-white border border-slate-200 rounded-lg p-5 hover:border-brand transition-colors"
        >
          <div class="w-14 h-14 rounded-full bg-brand text-white grid place-items-center text-xl font-bold flex-shrink-0">
            {author.data.name.split(' ').map((n) => n[0]).join('')}
          </div>
          <div class="flex-1">
            <div class="font-bold text-slate-900">{author.data.name}</div>
            <div class="text-sm text-brand font-semibold mb-1">{author.data.title}</div>
            <p class="text-sm text-slate-600">{author.data.bio}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-brand text-white">
    <div class="max-w-4xl mx-auto px-4 py-16 text-center">
      <h2 class="text-3xl font-extrabold mb-3">Service, DIY, or your bank — which actually costs less?</h2>
      <p class="text-lg text-white/80 mb-8 max-w-2xl mx-auto">
        Our free calculator answers the question in 30 seconds using your actual numbers —
        monthly check volume, service fee, and DIY costs. No signup required.
      </p>
      <a
        href="/calculator"
        class="inline-block bg-white text-brand px-8 py-4 rounded-md font-bold hover:bg-slate-100 transition-colors"
      >
        Run the Numbers →
      </a>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="flex items-baseline justify-between mb-8">
      <h2 class="text-2xl font-bold text-slate-900">Recent Articles</h2>
      <a href="/articles" class="text-sm font-semibold text-brand hover:text-brand-dark">
        View all &rarr;
      </a>
    </div>
    <div class="grid gap-4">
      {recent.map((article) => (
        <a
          href={`/articles/${article.slug}`}
          class="block border border-slate-200 rounded-lg p-5 hover:border-brand transition-colors"
        >
          <h3 class="font-bold text-slate-900">{article.data.title}</h3>
          <p class="text-slate-600 text-sm mt-1">{article.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
