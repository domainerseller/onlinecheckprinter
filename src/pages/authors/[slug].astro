---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({
    params: { slug: author.slug },
    props: { author },
  }));
}

interface Props {
  author: CollectionEntry<'authors'>;
}

const { author } = Astro.props;
const { Content } = await author.render();

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const authorArticles = allArticles
  .filter((a) => a.data.author === author.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title={`${author.data.name} — ${author.data.title} — OnlineCheckPrinter`}
  description={author.data.bio}
>
  <div class="max-w-3xl mx-auto px-4 py-12">
    <div class="mb-6 text-sm text-slate-500">
      <a href="/authors" class="hover:text-brand">&larr; All authors</a>
    </div>

    <div class="flex items-start gap-6 mb-8">
      <div class="w-24 h-24 rounded-full bg-brand text-white grid place-items-center text-3xl font-bold flex-shrink-0">
        {author.data.name.split(' ').map((n) => n[0]).join('')}
      </div>
      <div class="flex-1">
        <h1 class="text-3xl font-extrabold text-slate-900">{author.data.name}</h1>
        <div class="text-brand font-semibold mb-2">{author.data.title}</div>
        {author.data.yearsExperience && (
          <div class="text-sm text-slate-500">
            {author.data.yearsExperience}+ years of experience
          </div>
        )}
      </div>
    </div>

    {author.data.credentials.length > 0 && (
      <div class="mb-8 p-5 bg-slate-50 border border-slate-200 rounded-lg">
        <h2 class="font-bold text-slate-900 mb-3 text-sm uppercase tracking-wide">Credentials</h2>
        <ul class="space-y-1 text-slate-700 text-sm">
          {author.data.credentials.map((c) => (
            <li class="flex items-start gap-2">
              <span class="text-brand mt-0.5">✓</span>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {author.data.specialties.length > 0 && (
      <div class="mb-8">
        <h2 class="font-bold text-slate-900 mb-3 text-sm uppercase tracking-wide">Specialties</h2>
        <div class="flex flex-wrap gap-2">
          {author.data.specialties.map((spec) => (
            <span class="text-sm font-semibold text-brand bg-brand-light px-3 py-1 rounded-full">
              {spec}
            </span>
          ))}
        </div>
      </div>
    )}

    <div class="prose-article mb-12">
      <Content />
    </div>

    {authorArticles.length > 0 && (
      <div class="border-t border-slate-200 pt-10">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">
          Articles by {author.data.name}
        </h2>
        <div class="space-y-4">
          {authorArticles.map((article) => (
            <a
              href={`/articles/${article.slug}`}
              class="block border border-slate-200 rounded-lg p-5 hover:border-brand transition-colors"
            >
              <h3 class="font-bold text-slate-900">{article.data.title}</h3>
              <p class="text-slate-600 text-sm mt-1">{article.data.description}</p>
              <div class="text-xs text-slate-500 mt-2">{fmt(article.data.pubDate)}</div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
