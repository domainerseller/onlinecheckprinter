---
const nav = [
  { href: '/articles', label: 'Articles' },
  { href: '/calculator', label: 'Calculator' },
  { href: '/authors', label: 'Editors' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
---

<header class="border-b border-slate-200 bg-white sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-bold text-lg text-slate-900">
      <span class="inline-block w-8 h-8 rounded bg-brand text-white grid place-items-center">O</span>
      <span>OnlineCheckPrinter</span>
    </a>
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'hover:text-brand transition-colors',
            path === item.href ? 'text-brand' : 'text-slate-700',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a
      href="/calculator"
      class="hidden md:inline-flex bg-brand text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-brand-dark transition-colors"
    >
      Free Calculator
    </a>
  </div>
</header>
