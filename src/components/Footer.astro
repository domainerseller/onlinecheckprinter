---
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50 mt-20">
  <div class="max-w-6xl mx-auto px-4 py-10 grid gap-8 md:grid-cols-3 text-sm">
    <div>
      <div class="font-bold text-slate-900 mb-2">OnlineCheckPrinter</div>
      <p class="text-slate-600">
        Independent reviews and guides for businesses comparing check-printing services and software.
      </p>
    </div>
    <div>
      <div class="font-semibold text-slate-900 mb-2">Explore</div>
      <ul class="space-y-1 text-slate-600">
        <li><a href="/articles" class="hover:text-brand">Articles</a></li>
        <li><a href="/calculator" class="hover:text-brand">Calculator</a></li>
        <li><a href="/authors" class="hover:text-brand">Editors</a></li>
        <li><a href="/about" class="hover:text-brand">About</a></li>
        <li><a href="/rss.xml" class="hover:text-brand">RSS Feed</a></li>
      </ul>
    </div>
    <div>
      <div class="font-semibold text-slate-900 mb-2">Legal</div>
      <ul class="space-y-1 text-slate-600">
        <li><a href="/disclosure" class="hover:text-brand">Affiliate Disclosure</a></li>
        <li><a href="/privacy" class="hover:text-brand">Privacy Policy</a></li>
        <li><a href="/terms" class="hover:text-brand">Terms of Service</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-slate-200 py-4 text-center text-xs text-slate-500">
    &copy; {year} OnlineCheckPrinter.com. All rights reserved.
  </div>
</footer>
